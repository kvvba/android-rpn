<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calculator_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:hapticFeedbackEnabled="true"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <TextView
        android:id="@+id/formula"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.5"
        android:fontFamily="sans-serif-light"
        android:gravity="end|bottom"
        android:paddingLeft="@dimen/activity_margin"
        android:paddingRight="@dimen/activity_margin"
        android:textSize="@dimen/display_text_size"
        tools:text="3\n4" />

    <TextView
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:gravity="end"
        android:maxLines="1"
        android:paddingLeft="@dimen/activity_margin"
        android:paddingRight="@dimen/activity_margin"
        android:textSize="@dimen/display_text_size"
        tools:text="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_second"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="2nd"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_undo"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="undo"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_roll_up"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="R↑" />

        <TextView
            android:id="@+id/btn_roll_down"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="R↓" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_swap"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="x⇄y"
            android:textSize="18sp" />

        <FrameLayout
            android:id="@+id/btn_drop"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_drop_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="drop" />

            <TextView
                android:id="@+id/btn_drop_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="AC" />

        </FrameLayout>

        <TextView
            android:id="@+id/btn_chs"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="+/-" />

        <TextView
            android:id="@+id/btn_backspace"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌫" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_operators"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_percent"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_percent_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="%" />

            <TextView
                android:id="@+id/btn_percent_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="1/x" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_power"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_power_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="yˣ" />

            <TextView
                android:id="@+id/btn_power_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="ˣ√ʸ" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_root"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_root_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="√" />

            <TextView
                android:id="@+id/btn_root_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="x²" />

        </FrameLayout>

        <TextView
            android:id="@+id/btn_divide"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="÷" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_memory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_memory_clear"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="MC" />

        <TextView
            android:id="@+id/btn_memory_recall"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="MR" />

        <TextView
            android:id="@+id/btn_memory_add"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="M+" />

        <TextView
            android:id="@+id/btn_memory_subtract"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="M-" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_789"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_7"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="7" />

        <TextView
            android:id="@+id/btn_8"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="8" />

        <TextView
            android:id="@+id/btn_9"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="9" />

        <TextView
            android:id="@+id/btn_multiply"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="×" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_constants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_pi"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="π" />

        <TextView
            android:id="@+id/btn_e"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="e" />

        <TextView
            android:id="@+id/btn_log"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="logₓ(y)"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/btn_ln"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_ln_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="ln" />

            <TextView
                android:id="@+id/btn_ln_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="eˣ" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_456"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_4"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="4" />

        <TextView
            android:id="@+id/btn_5"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="5" />

        <TextView
            android:id="@+id/btn_6"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="6" />

        <TextView
            android:id="@+id/btn_minus"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="-" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_trig"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_hyp"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="hyp"
            android:textSize="18sp" />

        <FrameLayout
            android:id="@+id/btn_sin"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_sin_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="sin" />

            <TextView
                android:id="@+id/btn_sin_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="sin⁻¹" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_cos"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_cos_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="cos" />

            <TextView
                android:id="@+id/btn_cos_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="cos⁻¹" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_tan"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_tan_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="tan" />

            <TextView
                android:id="@+id/btn_tan_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="tan⁻¹" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_123"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_1"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="1" />

        <TextView
            android:id="@+id/btn_2"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="2" />

        <TextView
            android:id="@+id/btn_3"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="3" />

        <TextView
            android:id="@+id/btn_plus"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="+" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_blank"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/btn_log10"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_log10_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:textSize="16sp"
                android:text="log10" />

            <TextView
                android:id="@+id/btn_log10_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="10ˣ" />

        </FrameLayout>

        <TextView
            android:id="@+id/btn_npr"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="nPr"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_ncr"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="nCr"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_blank_row_blank"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_exponent"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="E" />

        <TextView
            android:id="@+id/btn_blank_exponent"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_0"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="0" />

        <TextView
            android:id="@+id/btn_blank_zero"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_decimal"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="." />

        <TextView
            android:id="@+id/btn_blank_decimal"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_enter"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="enter"
            android:textSize="18sp" />

    </LinearLayout>
</LinearLayout>

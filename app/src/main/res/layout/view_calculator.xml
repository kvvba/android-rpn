<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/calculator_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:hapticFeedbackEnabled="true"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    tools:ignore="HardcodedText">

    <TextView
        android:id="@+id/formula"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3.5"
        android:fontFamily="sans-serif-light"
        android:gravity="end|bottom"
        android:paddingLeft="@dimen/activity_margin"
        android:paddingRight="@dimen/activity_margin"
        android:textSize="@dimen/display_text_size"
        tools:text="3\n4" />

    <TextView
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:gravity="end"
        android:maxLines="1"
        android:paddingLeft="@dimen/activity_margin"
        android:paddingRight="@dimen/activity_margin"
        android:textSize="@dimen/display_text_size"
        tools:text="0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_second"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="2nd"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_undo"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="undo"
            android:textSize="18sp" />

        <FrameLayout
            android:id="@+id/btn_roll_down"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_roll_down_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="R↓" />

            <TextView
                android:id="@+id/btn_roll_down_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="R↑" />

        </FrameLayout>

        <TextView
            android:id="@+id/btn_const"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="const"
            android:textSize="16sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_swap"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_swap_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:textSize="18sp"
                android:text="x⇄y" />

            <TextView
                android:id="@+id/btn_swap_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="LSTx" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_drop"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_drop_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="drop" />

            <TextView
                android:id="@+id/btn_drop_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="AC" />

        </FrameLayout>

        <TextView
            android:id="@+id/btn_chs"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="+/-" />

        <TextView
            android:id="@+id/btn_backspace"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌫" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_operators"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_percent"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_percent_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="%" />

            <TextView
                android:id="@+id/btn_percent_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="1/x" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_power"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_power_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="yˣ" />

            <TextView
                android:id="@+id/btn_power_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="ˣ√ʸ" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_root"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_root_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="√" />

            <TextView
                android:id="@+id/btn_root_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="x²" />

        </FrameLayout>

        <TextView
            android:id="@+id/btn_divide"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="÷" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_789"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_7"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_7_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="7" />

            <TextView
                android:id="@+id/btn_7_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="n!" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_8"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_8_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="8" />

            <TextView
                android:id="@+id/btn_8_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="nCr" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_9"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_9_primary"

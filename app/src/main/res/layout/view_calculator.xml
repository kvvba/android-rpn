            <TextView
                android:id="@+id/btn_9_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="nPr" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_multiply"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_multiply_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="×" />

            <TextView
                android:id="@+id/btn_multiply_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="Π" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_trig"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btn_hyp"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="hyp"
            android:textSize="18sp" />

        <FrameLayout
            android:id="@+id/btn_sin"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_sin_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="sin" />

            <TextView
                android:id="@+id/btn_sin_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="sin⁻¹" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_cos"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_cos_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="cos" />

            <TextView
                android:id="@+id/btn_cos_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="cos⁻¹" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_tan"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_tan_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="tan" />

            <TextView
                android:id="@+id/btn_tan_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="tan⁻¹" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_456"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_4"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_4_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="4" />

            <TextView
                android:id="@+id/btn_4_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="MC" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_5"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_5_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="5" />

            <TextView
                android:id="@+id/btn_5_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="MR" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_6"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_6_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="6" />

            <TextView
                android:id="@+id/btn_6_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="M+" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_minus"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_minus_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="-" />

            <TextView
                android:id="@+id/btn_minus_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="M-" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_constants"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/btn_mod"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_mod_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="mod" />

            <TextView
                android:id="@+id/btn_mod_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="quot" />

        </FrameLayout>

        <TextView
            android:id="@+id/btn_log"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="logₓ(y)"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/btn_ln"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_ln_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="ln" />

            <TextView
                android:id="@+id/btn_ln_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="eˣ" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_log10"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_log10_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:textSize="16sp"
                android:text="log₁₀" />

            <TextView
                android:id="@+id/btn_log10_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="10ˣ" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_123"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_1"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_1_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="1" />

            <TextView
                android:id="@+id/btn_1_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="π" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_2"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_2_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="2" />

            <TextView
                android:id="@+id/btn_2_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="e" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_3"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_3_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="3" />

            <TextView
                android:id="@+id/btn_3_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="Δ%" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_plus"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_plus_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="+" />

            <TextView
                android:id="@+id/btn_plus_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="Σ" />

        </FrameLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/btn_exponent"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_exponent_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="E" />

            <TextView
                android:id="@+id/btn_exponent_secondary"
                style="@style/MyTwoTierButtonSecondary"
                android:text="⇤" />

        </FrameLayout>

        <TextView
            android:id="@+id/btn_blank_exponent"
            style="@style/MyButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/btn_0"
            style="@style/MyTwoTierButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <TextView
                android:id="@+id/btn_0_primary"
                style="@style/MyTwoTierButtonPrimary"
                android:text="0" />

            <TextView
                android:id="@+id/btn_0_secondary"
                style="@style/MyTwoTierButtonSecondary"
